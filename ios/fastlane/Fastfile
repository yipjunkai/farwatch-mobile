default_platform(:ios)

# Shared constants — single source of truth for Fastlane config.
# Team ID and bundle ID must also be set in:
#   - ios/Flutter/Signing.xcconfig (for Xcode builds)
#   - ios/ExportOptions.plist (for flutter build ipa)
# These cannot share a config format, so duplication is unavoidable.
APP_IDENTIFIER = "dev.farwatch.app"
TEAM_ID = "P2T5PQM7H2"
IPA_PATH = "../build/ios/ipa/Farwatch.ipa"

# Helper to build the App Store Connect API key from environment variables.
# Used by both Match (for cert/profile management) and Pilot (for TestFlight upload).
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_CONTENT"],
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do
  desc "Sync certificates and provisioning profiles via Match"
  lane :sync_certs do
    match(type: "appstore", api_key: asc_api_key)
  end

  desc "Upload pre-built IPA to TestFlight (certs already synced via sync_certs lane)"
  lane :beta do
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: IPA_PATH,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Build IPA for App Store / TestFlight (used in CI)"
  lane :build do
    match(type: "appstore", api_key: asc_api_key)

    profile_name = ENV["PROVISIONING_PROFILE_NAME"] || "match AppStore #{APP_IDENTIFIER}"

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store-connect",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      },

      output_directory: "../build/ios/ipa",
      output_name: "Farwatch.ipa"
    )
  end

  desc "Full CI pipeline: build + upload to TestFlight"
  lane :ci_beta do
    build

    upload_to_testflight(
      api_key: asc_api_key,
      ipa: IPA_PATH,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
